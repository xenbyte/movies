#!/usr/bin/env bash
# CLI tool to pull Jellyfin activity logs (logins, playback, admin actions)
# for the xenbyte/movies deployment.
#
# Setup:
#   mkdir -p ~/.config/movies-cli
#   cat > ~/.config/movies-cli/config <<'EOF'
#   MOVIES_API_KEY=<jellyfin api key>
#   EOF
#
# Usage:
#   movies-logs                      # last 200 entries, all users
#   movies-logs -u thais             # only thais's activity
#   movies-logs -u hbeh -n 50
#   movies-logs -t VideoPlayback     # only playback-start events
#   movies-logs --watch              # poll every 5s for new entries

set -euo pipefail

CONFIG_FILE="${MOVIES_CLI_CONFIG:-$HOME/.config/movies-cli/config}"
if [ -f "$CONFIG_FILE" ]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

: "${MOVIES_API_KEY:?No API key found. Put MOVIES_API_KEY=... in $CONFIG_FILE or export it.}"
NAMESPACE="${MOVIES_NAMESPACE:-movies}"
SERVICE="${MOVIES_JELLYFIN_SERVICE:-jellyfin}"

usage() {
  cat <<EOF
Usage: movies-logs [options]

Options:
  -u, --user <name>    Filter to a specific username (e.g. thais, hbeh)
  -n, --limit <N>       Entries to fetch before filtering (default: 200)
  -t, --type <Type>     Filter by activity Type (e.g. VideoPlayback,
                         VideoPlaybackStopped, AuthenticationSucceeded,
                         AuthenticationFailed, SessionStarted)
  -w, --watch           Poll every 5s and print new entries as they happen
  -h, --help            Show this help
EOF
}

USER_FILTER=""
LIMIT=200
TYPE_FILTER=""
WATCH=0

while [ $# -gt 0 ]; do
  case "$1" in
    -u|--user) USER_FILTER="$2"; shift 2 ;;
    -n|--limit) LIMIT="$2"; shift 2 ;;
    -t|--type) TYPE_FILTER="$2"; shift 2 ;;
    -w|--watch) WATCH=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
done

LOCAL_PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("",0)); print(s.getsockname()[1]); s.close()')

kubectl port-forward -n "$NAMESPACE" "svc/$SERVICE" "$LOCAL_PORT:80" >/tmp/movies-logs-pf.log 2>&1 &
PF_PID=$!
trap 'kill $PF_PID 2>/dev/null || true' EXIT

for _ in $(seq 1 20); do
  curl -s -o /dev/null "http://127.0.0.1:$LOCAL_PORT/System/Ping" 2>/dev/null && break
  sleep 0.5
done

BASE="http://127.0.0.1:$LOCAL_PORT"

STATE_FILE=$(mktemp)
cleanup() {
  kill "$PF_PID" 2>/dev/null || true
  wait "$PF_PID" 2>/dev/null || true
  rm -f "$STATE_FILE"
}
trap cleanup EXIT

run_query() {
  python3 - "$BASE" "$MOVIES_API_KEY" "$USER_FILTER" "$LIMIT" "$TYPE_FILTER" "$STATE_FILE" <<'PYEOF'
import sys, json, urllib.request

base, api_key, user_filter, limit, type_filter, state_file = sys.argv[1:7]

def get(path):
    sep = "&" if "?" in path else "?"
    req = urllib.request.Request(f"{base}{path}{sep}ApiKey={api_key}")
    with urllib.request.urlopen(req) as r:
        return json.load(r)

since = ""
try:
    with open(state_file) as f:
        since = f.read().strip()
except FileNotFoundError:
    pass

user_id = None
if user_filter:
    users = get("/Users")
    for u in users:
        if u["Name"].lower() == user_filter.lower():
            user_id = u["Id"]
            break
    if not user_id:
        print(f"No such user: {user_filter}", file=sys.stderr)
        sys.exit(1)

entries = get(f"/System/ActivityLog/Entries?Limit={limit}")["Items"]
entries.reverse()  # oldest first

latest = since
for e in entries:
    if since and e["Date"] <= since:
        continue
    if user_id and e.get("UserId") != user_id:
        continue
    if type_filter and e.get("Type") != type_filter:
        continue
    print(f"{e['Date']}  {e['Type']:<24} {e['Name']}")
    if e["Date"] > latest:
        latest = e["Date"]

with open(state_file, "w") as f:
    f.write(latest)
PYEOF
}

if [ "$WATCH" -eq 1 ]; then
  run_query >/dev/null  # prime state file with current latest entry, don't dump history
  echo "Watching for new activity (Ctrl+C to stop)..." >&2
  while true; do
    run_query
    sleep 5
  done
else
  run_query
fi
